rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 64
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorldSave(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'name',
          'weatherState',
          'autoWeather',
          'trafficDensity',
          'pedestrianDensity',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'name',
          'weatherState',
          'autoWeather',
          'trafficDensity',
          'pedestrianDensity',
          'createdAt',
          'updatedAt'
        ])
        && data.ownerId is string
        && data.ownerId == userId
        && data.ownerId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 64
        && data.weatherState in ['CLEAR', 'OVERCAST', 'RAIN', 'FOG', 'SNOW']
        && data.autoWeather is bool
        && data.trafficDensity is number
        && data.trafficDensity >= 0
        && data.trafficDensity <= 40
        && data.pedestrianDensity is number
        && data.pedestrianDensity >= 0
        && data.pedestrianDensity <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);

      allow delete: if false;

      match /worldSaves/{saveId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && isValidId(saveId)
          && request.auth.uid == userId;

        allow list: if isSignedIn()
          && resource.data.ownerId == request.auth.uid;

        allow create: if isVerified()
          && isValidId(userId)
          && isValidId(saveId)
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidWorldSave(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerified()
          && isValidId(userId)
          && isValidId(saveId)
          && request.auth.uid == userId
          && isValidWorldSave(incoming(), userId)
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'weatherState',
            'autoWeather',
            'trafficDensity',
            'pedestrianDensity',
            'updatedAt'
          ]);

        allow delete: if isVerified()
          && isValidId(userId)
          && isValidId(saveId)
          && request.auth.uid == userId;
      }
    }
  }
}
